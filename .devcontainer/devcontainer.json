{
  "name": "IotMonitor - .NET 8",
  "image": "mcr.microsoft.com/devcontainers/dotnet:8.0-jammy",
  "workspaceFolder": "/workspaces/IotMonitor",
  "runArgs": [
    "--network", "iotmonitor_iotmonitor-network"
  ],
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/node:1": {
      "version": "24"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.csharp",
        "ms-dotnettools.csharp",
        "ms-dotnettools.csdevkit",
        "ms-mssql.mssql"
      ],
      "settings": {
        "dotnet.defaultSolutionDirPath": "${workspaceFolder}",
        "[csharp]": {
          "editor.formatOnSave": true,
          "editor.defaultFormatter": "ms-dotnettools.csharp"
        }
      }
    }
  },
  "postCreateCommand": "dotnet tool list -g | grep -q dotnet-ef || dotnet tool install --global dotnet-ef",
  "remoteUser": "vscode"
}