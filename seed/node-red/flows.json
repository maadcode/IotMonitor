    {
        "id": "3c4f1840d8b443d5",
        "type": "function",
        "z": "4eeaceded1074a4b",
        "name": "Gestionar Pool",
        "func": "var clients = flow.get(\"tcp_clients\") || {};\n\nif (msg._session) {\n    var id = msg._session.id;\n    var isEmpty = !msg.payload ||\n                  (Buffer.isBuffer(msg.payload) && msg.payload.length === 0) ||\n                  (typeof msg.payload === 'string' && msg.payload.length === 0);\n\n    if (isEmpty) {\n        if (clients[id]) {\n            delete clients[id];\n            node.warn(\"[Pool] Cliente desconectado: \" + id);\n        }\n    } else {\n        var isNew = !clients[id];\n        clients[id] = msg._session;\n        if (isNew) node.warn(\"[Pool] Cliente registrado: \" + id);\n    }\n\n    flow.set(\"tcp_clients\", clients);\n    var count = Object.keys(clients).length;\n    node.status({fill: count > 0 ? \"green\" : \"red\", shape:\"dot\", text:\"Clientes: \" + count});\n}\nreturn null;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "flow.set(\"tcp_clients\", {});\nnode.status({fill:\"grey\",shape:\"ring\",text:\"Pool limpio\"});\nnode.warn(\"[Pool] Inicializado — sesiones anteriores descartadas\");",
        "finalize": "flow.set(\"tcp_clients\", {});\nnode.warn(\"[Pool] Finalizado — sesiones descartadas\");",
        "libs": [],
        "x": 360,
        "y": 140,
        "wires": [
            [
                "44c9d7856832f654"
            ]
        ]
    },
