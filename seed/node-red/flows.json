    {
        "id": "e88237be19a9c1ec",
        "type": "function",
        "z": "4eeaceded1074a4b",
        "name": "Broadcast",
        "func": "var clients = flow.get(\"tcp_clients\") || {};\nvar data = Buffer.from([msg.payload ? 1 : 0]);\nvar msgs = [];\n\nfor (var id in clients) {\n    msgs.push({ _session: clients[id], payload: data });\n}\nreturn [msgs];",
